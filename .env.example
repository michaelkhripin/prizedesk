# PayPal sandbox app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# LLM provider: mock | gemini | anthropic  (mock runs without any key)
LLM_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Hard ceiling for a single payout batch, in USD. The agent can never exceed it.
MAX_BATCH_USD=30000
