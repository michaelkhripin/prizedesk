{
  "name": "prizedesk",
  "version": "0.1.0",
  "private": true,
  "description": "AI payout desk for game prize pools and creator revenue share, built on PayPal",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "agent:live": "tsx scripts/agent-live.ts",
    "e2e:sandbox": "tsx scripts/sandbox-e2e.ts",
    "start": "tsx src/server/index.ts",
    "dev:api": "tsx watch src/server/index.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"API_PORT=8787 tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.7",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/react-paypal-js": "^8.9.2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
