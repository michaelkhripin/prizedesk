{
  "name": "prizedesk",
  "version": "0.1.0",
  "private": true,
  "description": "AI payout desk for game prize pools and creator revenue share, built on PayPal",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "agent:live": "tsx scripts/agent-live.ts",
    "e2e:sandbox": "tsx scripts/sandbox-e2e.ts",
    "start": "tsx src/server/index.ts",
    "dev:api": "tsx watch src/server/index.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "express": "^4.22.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
